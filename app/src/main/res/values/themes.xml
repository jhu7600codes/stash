<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Stash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- the splash: the icon's bars on its own color, then the app (MainActivity animates the hand-off) -->
    <style name="Theme.Stash.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#7CC8F8</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Stash</item>
    </style>
</resources>
