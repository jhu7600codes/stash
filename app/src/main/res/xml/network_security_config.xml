<?xml version="1.0" encoding="utf-8"?>
<!-- the youtube frontends (invidious / piped) on the community list are mostly plain http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
